{% doc %}
  @prompt
    Add custom CSS to center-align the collection icons in the collection icons row block. The icons are currently left-aligned and need to be centered horizontally. Target the collection icons row section to make the flex container justify content to center so all circular icons appear in the middle of the row.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-icons-row-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-collection-icons-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-collection-icon-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.3s ease;
  }

  .ai-collection-icon-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-collection-icon-circle-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_background_color }};
    border: {{ block.settings.icon_border_width }}px solid {{ block.settings.icon_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ai-collection-icon-circle-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-icon-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    text-align: center;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-icons-container-{{ ai_gen_id }} {
      gap: {{ block.settings.icon_spacing | times: 0.7 }}px;
    }

    .ai-collection-icon-circle-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-collection-icon-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<collection-icons-row-{{ ai_gen_id }}
  class="ai-collection-icons-row-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-icons-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
        assign image_key = 'collection_' | append: i | append: '_image'
        assign custom_image = block.settings[image_key]
      %}

      {% if collection != blank %}
        <a
          href="{{ collection.url }}"
          class="ai-collection-icon-item-{{ ai_gen_id }}"
        >
          <div class="ai-collection-icon-circle-{{ ai_gen_id }}">
            {% if custom_image != blank %}
              <img
                src="{{ custom_image | image_url: width: 300 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="300"
                height="300"
              >
            {% elsif collection.image %}
              <img
                src="{{ collection.image | image_url: width: 300 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="300"
                height="300"
              >
            {% else %}
              <div class="ai-collection-icon-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <h3 class="ai-collection-icon-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</collection-icons-row-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionIconsRow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const links = this.querySelectorAll('.ai-collection-icon-item-{{ ai_gen_id }}');
        links.forEach(link => {
          if (!link.getAttribute('aria-label')) {
            const title = link.querySelector('.ai-collection-icon-title-{{ ai_gen_id }}');
            if (title) {
              link.setAttribute('aria-label', 'View ' + title.textContent + ' collection');
            }
          }
        });
      }
    }

    customElements.define('collection-icons-row-{{ ai_gen_id }}', CollectionIconsRow{{ ai_gen_id }});
  })();
</script>

