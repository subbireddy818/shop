{% doc %}
  @prompt
    Create a collection icons row section that displays circular collection images in a horizontal scrollable row below the header navigation. Each item should show a circular image with the collection name below it, similar to a category quick-links bar. The section should be customizable to add/remove collection icons, and should work well on both desktop and mobile.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-icons-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-collection-icons-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-collection-icons-title-{{ ai_gen_id }} {
    text-align: {{ block.settings.title_alignment }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-collection-icons-scroll-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-collection-icons-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .ai-collection-icons-scroll-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-collection-icons-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 3px;
  }

  .ai-collection-icons-grid-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    padding-bottom: 10px;
  }

  .ai-collection-icons-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    width: {{ block.settings.icon_size }}px;
    transition: transform 0.3s ease;
  }

  .ai-collection-icons-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-collection-icons-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: {{ block.settings.label_spacing }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.image_background }};
    position: relative;
  }

  .ai-collection-icons-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-icons-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-icons-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-icons-label-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    word-wrap: break-word;
    width: 100%;
  }

  .ai-collection-icons-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #999;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-icons-item-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-collection-icons-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-collection-icons-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.item_spacing_mobile }}px;
    }
  }
{% endstyle %}

<collection-icons-{{ ai_gen_id }} class="ai-collection-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-icons-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="ai-collection-icons-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    {% endif %}

    {% assign has_collections = false %}
    {% for i in (1..10) %}
      {% assign collection_key = 'collection_' | append: i %}
      {% if block.settings[collection_key] != blank %}
        {% assign has_collections = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_collections %}
      <div class="ai-collection-icons-scroll-{{ ai_gen_id }}">
        <div class="ai-collection-icons-grid-{{ ai_gen_id }}">
          {% for i in (1..10) %}
            {% assign collection_key = 'collection_' | append: i %}
            {% assign collection = block.settings[collection_key] %}
            
            {% if collection != blank %}
              <a href="{{ collection.url }}" class="ai-collection-icons-item-{{ ai_gen_id }}">
                <div class="ai-collection-icons-image-wrapper-{{ ai_gen_id }}">
                  {% if collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 300 }}"
                      alt="{{ collection.title | escape }}"
                      class="ai-collection-icons-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  {% elsif collection.products.first and collection.products.first.featured_image %}
                    <img
                      src="{{ collection.products.first.featured_image | image_url: width: 300 }}"
                      alt="{{ collection.title | escape }}"
                      class="ai-collection-icons-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="300"
                    >
                  {% else %}
                    <div class="ai-collection-icons-placeholder-{{ ai_gen_id }}">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <span class="ai-collection-icons-label-{{ ai_gen_id }}">{{ collection.title }}</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="ai-collection-icons-empty-state-{{ ai_gen_id }}">
        Add collections to display them here
      </div>
    {% endif %}
  </div>
</collection-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        const scrollContainer = this.querySelector('.ai-collection-icons-scroll-{{ ai_gen_id }}');
        if (!scrollContainer) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        scrollContainer.addEventListener('mousedown', (e) => {
          isDown = true;
          scrollContainer.style.cursor = 'grabbing';
          startX = e.pageX - scrollContainer.offsetLeft;
          scrollLeft = scrollContainer.scrollLeft;
        });

        scrollContainer.addEventListener('mouseleave', () => {
          isDown = false;
          scrollContainer.style.cursor = 'grab';
        });

        scrollContainer.addEventListener('mouseup', () => {
          isDown = false;
          scrollContainer.style.cursor = 'grab';
        });

        scrollContainer.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - scrollContainer.offsetLeft;
          const walk = (x - startX) * 2;
          scrollContainer.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('collection-icons-{{ ai_gen_id }}', CollectionIcons{{ ai_gen_id }});
  })();
</script>

