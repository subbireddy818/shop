<section class="w-full py-16 md:py-24 bg-[#FDF6EC]">
  <div class="max-w-[1400px] mx-auto px-6">
    <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-6 md:gap-8">
      {% for block in section.blocks %}
        <a href="{{ block.settings.link }}" class="flex flex-col items-center gap-4 group cursor-pointer" {{ block.shopify_attributes }}>
          <div class="relative w-20 h-20 md:w-32 md:h-32 rounded-full overflow-hidden border-2 border-[#D4AF37]/20 transition-all duration-500 group-hover:border-[#6A1039] group-hover:shadow-xl shadow-md bg-white">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 300 }}" 
                alt="{{ block.settings.title }}"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              >
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'w-full h-full bg-gray-100' }}
            {% endif %}
          </div>
          <p class="font-heading font-[700] text-[10px] md:text-[13px] text-[#1A1A1A] tracking-[2px] uppercase group-hover:text-[#6A1039] transition-colors text-center">
            {{ block.settings.title }}
          </p>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Karungali" } },
        { "type": "category", "settings": { "title": "Rings" } },
        { "type": "category", "settings": { "title": "Frames" } },
        { "type": "category", "settings": { "title": "Kits" } },
        { "type": "category", "settings": { "title": "Lockets" } },
        { "type": "category", "settings": { "title": "Brass" } },
        { "type": "category", "settings": { "title": "Yantras" } }
      ]
    }
  ]
}
{% endschema %}
