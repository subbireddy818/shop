<header class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300 bg-white shadow-sm border-b border-gray-100">
  {% comment %} 1. Top Bar {% endcomment %}
  <div class="w-full bg-[#FDF6EC] border-b border-[#D4AF37]/10 py-1 hidden md:block">
    <div class="max-w-[1400px] mx-auto px-6 flex justify-between items-center text-[10px] font-heading font-bold tracking-[1.2px] uppercase text-[#6A1039]/80">
      <div>{{ section.settings.announcement_text }}</div>
      <div class="flex gap-6">
        <a href="/apps/track-order" class="hover:text-[#6A1039] transition-colors">Track Order</a>
        <a href="/pages/support" class="hover:text-[#6A1039] transition-colors">Support</a>
      </div>
    </div>
  </div>

  {% comment %} 2. Unified Main Row: Logo, Nav, Search, Icons {% endcomment %}
  <div class="max-w-[1400px] mx-auto px-6 py-1.5 flex items-center justify-between gap-6">
    {% comment %} Logo {% endcomment %}
    <a href="{{ routes.root_url }}" class="flex-shrink-0 group">
      {% if section.settings.logo != blank %}
        <img 
          src="{{ section.settings.logo | image_url: width: 400 }}" 
          alt="{{ shop.name }}" 
          class="h-16 md:h-20 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        >
      {% else %}
        <span class="font-heading font-bold text-xl">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% comment %} Navigation Links {% endcomment %}
    <nav class="hidden lg:flex items-center gap-8">
      {% for link in linklists[section.settings.menu].links %}
        <a
          href="{{ link.url }}"
          class="font-heading font-bold text-[14px] tracking-[2px] transition-all relative py-1 hover:text-[#6A1039] group whitespace-nowrap {% if link.active %}text-[#6A1039]{% else %}text-[#1A1A1A]{% endif %}"
        >
          {{ link.title | uppercase }}
          <span class="absolute bottom-0 left-0 w-full h-0.5 bg-[#6A1039] transition-transform duration-300 transform {% if link.active %}scale-x-100{% else %}scale-x-0 group-hover:scale-x-100{% endif %}" />
        </a>
      {% endfor %}
    </nav>

    {% comment %} Search Bar {% endcomment %}
    <div class="flex-1 max-w-sm relative hidden md:block">
      <form action="{{ routes.search_url }}" method="get" role="search" class="relative flex items-center bg-gray-50 rounded-full border border-gray-200 focus-within:border-[#6A1039] focus-within:ring-2 focus-within:ring-[#6A1039]/10 transition-all duration-300">
        <span class="material-symbols-outlined absolute left-4 text-gray-400 text-[18px]">search</span>
        <input
          type="text"
          name="q"
          placeholder="Search..."
          class="w-full bg-transparent pl-11 pr-4 py-2 text-[12px] font-body text-[#1A1A1A] placeholder-gray-400 focus:outline-none rounded-full"
        >
      </form>
    </div>

    {% comment %} Action Icons {% endcomment %}
    <div class="flex items-center gap-4">
      <a href="{{ routes.account_url }}" class="text-[#1A1A1A] hover:text-[#6A1039] transition-colors">
        <span class="material-symbols-outlined text-[24px]">person</span>
      </a>
      <a href="{{ routes.cart_url }}" id="cart-icon-target" class="relative text-[#1A1A1A] hover:text-[#6A1039] transition-colors">
        <span class="material-symbols-outlined text-[24px]">shopping_cart</span>
        <span class="absolute -top-1 -right-1 bg-[#6A1039] text-white text-[9px] font-bold w-4 h-4 rounded-full flex items-center justify-center cart-count">
          {{ cart.item_count }}
        </span>
      </a>
      {% comment %} Mobile Menu Icon {% endcomment %}
      <button class="md:hidden text-[#1A1A1A]">
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
    </div>
  </div>

  {% comment %} Mobile Search Bar {% endcomment %}
  <div class="px-4 pb-3 md:hidden">
    <form action="{{ routes.search_url }}" method="get" class="relative flex items-center bg-gray-50 rounded-full border border-gray-200">
      <span class="material-symbols-outlined absolute left-3 text-gray-400 text-sm">search</span>
      <input
        type="text"
        name="q"
        placeholder="Search..."
        class="w-full bg-transparent pl-10 pr-4 py-1.5 text-xs font-body focus:outline-none"
      />
    </form>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free shipping on orders over ₹1,999"
    }
  ]
}
{% endschema %}
