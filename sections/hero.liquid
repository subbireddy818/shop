<section class="relative w-full min-h-[80vh] flex items-center justify-center overflow-hidden">
  {% comment %} Background Image with Overlay {% endcomment %}
  <div class="absolute inset-0 z-0">
    {% if section.settings.image != blank %}
      <img 
        src="{{ section.settings.image | image_url: width: 2000 }}" 
        alt="{{ section.settings.title }}"
        class="w-full h-full object-cover"
      >
    {% else %}
      <div class="w-full h-full bg-[#1A1A1A]"></div>
    {% endif %}
    <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 text-center">
    <div class="flex flex-col items-center gap-8">
      <span class="font-heading font-bold text-[12px] md:text-[14px] text-[#D4AF37] tracking-[4px] uppercase animate-fade-in">
        {{ section.settings.subheading }}
      </span>
      
      <h1 class="font-heading font-[800] text-[40px] md:text-[72px] lg:text-[84px] text-white leading-[1.1] tracking-[-1px] uppercase max-w-5xl">
        {{ section.settings.title }}
      </h1>
      
      <p class="font-body font-[400] text-[16px] md:text-[20px] text-white/90 leading-[1.6] max-w-2xl italic">
        {{ section.settings.text }}
      </p>
      
      <div class="flex flex-col sm:row items-center justify-center gap-4 mt-4">
        <a 
          href="{{ section.settings.button_link }}" 
          class="h-14 px-10 bg-[#6A1039] text-[#D4AF37] font-bold rounded-full border border-[#D4AF37]/30 shadow-2xl hover:bg-[#D4AF37] hover:text-[#6A1039] transition-all duration-300 transform hover:scale-105 active:scale-95 uppercase tracking-widest text-sm flex items-center justify-center"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    </div>
  </div>

  {% comment %} Decorative Bottom Fade {% endcomment %}
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#FDF6EC] to-transparent z-10"></div>
</section>

{% schema %}
{
  "name": "Hero Slideshow",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sacred Realm Heritage"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Trusted by 50,000+ Devotees"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bringing Devotion to Your Doorstep with Authentic Spiritual Products."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Slideshow"
    }
  ]
}
{% endschema %}
