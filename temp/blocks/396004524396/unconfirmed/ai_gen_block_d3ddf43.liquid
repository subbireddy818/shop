              </a>
              {% if block.settings.nav_2_dropdown != blank %}
                <div class="ai-header-dropdown-{{ ai_gen_id }}">
                  {% assign dropdown_links = block.settings.nav_2_dropdown | split: ',' %}
                  {% for link in dropdown_links %}
                    {% assign link_parts = link | split: '|' %}
                    <a href="{{ link_parts[1] | strip }}" class="ai-header-dropdown-link-{{ ai_gen_id }}">{{ link_parts[0] | strip }}</a>
                  {% endfor %}
