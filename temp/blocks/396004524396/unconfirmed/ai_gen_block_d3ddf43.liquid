                {% if block.settings.nav_2_dropdown != blank %}
                  <svg class="ai-header-nav-arrow-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M7 10l5 5 5-5z"/>
                  </svg>
