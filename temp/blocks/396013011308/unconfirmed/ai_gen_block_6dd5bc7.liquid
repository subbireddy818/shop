{% doc %}
  @prompt
    Create a horizontal scrollable category icons row section similar to a quick-links bar. Each item displays a circular product/collection image with a category name below it. The row should have a light beige/cream background, show 6-8 circular icons in a row on desktop, and be horizontally scrollable on mobile. Each icon should be clickable and link to a collection. The circular images should have a subtle border, and the category names should be in a small dark font below each circle. The section should be customizable to add/remove collection icons with settings for image, label, and link URL for each item.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-icons-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    width: 100%;
  }

  .ai-category-icons-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-icons-scroll-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.icon_spacing }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
    padding-bottom: 10px;
  }

  .ai-category-icons-scroll-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .ai-category-icons-scroll-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-category-icons-scroll-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 3px;
  }

  .ai-category-icon-item-{{ ai_gen_id }} {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    transition: transform 0.3s ease;
    width: {{ block.settings.icon_size }}px;
  }

  .ai-category-icon-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-category-icon-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    border-radius: 50%;
    overflow: hidden;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    margin-bottom: 12px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-icon-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-icon-image-wrapper-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-icon-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    color: {{ block.settings.label_color }};
    text-align: center;
    line-height: 1.3;
    word-wrap: break-word;
    max-width: {{ block.settings.icon_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-category-icons-scroll-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_icon_spacing }}px;
    }

    .ai-category-icon-item-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-category-icon-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.mobile_icon_size }}px;
      height: {{ block.settings.mobile_icon_size }}px;
    }

    .ai-category-icon-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_label_font_size }}px;
      max-width: {{ block.settings.mobile_icon_size }}px;
    }
  }
{% endstyle %}

<category-icons-{{ ai_gen_id }} class="ai-category-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-icons-container-{{ ai_gen_id }}">
    <div class="ai-category-icons-scroll-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign label_key = 'label_' | append: i
          assign collection = block.settings[collection_key]
          assign label = block.settings[label_key]
        %}

        {% if collection != blank %}
          <a href="{{ collection.url }}" class="ai-category-icon-item-{{ ai_gen_id }}">
            <div class="ai-category-icon-image-wrapper-{{ ai_gen_id }}">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 200 }}"
                  alt="{{ collection.title | escape }}"
                  class="ai-category-icon-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% elsif collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 200 }}"
                  alt="{{ collection.title | escape }}"
                  class="ai-category-icon-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                {{ 'collection-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
            <span class="ai-category-icon-label-{{ ai_gen_id }}">
              {% if label != blank %}
                {{ label }}
              {% else %}
                {{ collection.title }}
              {% endif %}
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</category-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.scrollContainer = this.querySelector('.ai-category-icons-scroll-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.scrollContainer) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.scrollContainer.addEventListener('mousedown', (e) => {
          isDown = true;
          this.scrollContainer.style.cursor = 'grabbing';
          startX = e.pageX - this.scrollContainer.offsetLeft;
          scrollLeft = this.scrollContainer.scrollLeft;
        });

        this.scrollContainer.addEventListener('mouseleave', () => {
          isDown = false;
          this.scrollContainer.style.cursor = 'grab';
        });

        this.scrollContainer.addEventListener('mouseup', () => {
          isDown = false;
          this.scrollContainer.style.cursor = 'grab';
        });

        this.scrollContainer.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.scrollContainer.offsetLeft;
          const walk = (x - startX) * 2;
          this.scrollContainer.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('category-icons-{{ ai_gen_id }}', CategoryIcons{{ ai_gen_id }});
  })();
</script>

